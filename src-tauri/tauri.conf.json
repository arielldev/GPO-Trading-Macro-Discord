{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trading And Shi",
  "version": "2.0.0",
  "identifier": "com.arielldev.tradingandshi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Trading And Shi",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#1e1f22"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "arielldev",
    "copyright": "Copyright © 2026 arielldev",
    "category": "Utility",
    "shortDescription": "Discord message scheduler",
    "longDescription": "Schedules emoji messages to Discord channels you choose, using an account token you provide.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
